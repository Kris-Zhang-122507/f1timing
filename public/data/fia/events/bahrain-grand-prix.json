"ES":7,"PU-CE":6,"PU-ANC":8},"team":"Aston Martin"},{"n":"14","car":"Aston Martin Aramco Honda","driver":"Fernando Alonso","used":{"ICE":5,"TC":5,"EXH":3,"MGU-K":5,"ES":7,"PU-CE":6,"PU-ANC":9},"team":"Aston Martin"},{"n":"31","car":"Haas Ferrari","driver":"Esteban Ocon","used":{"ICE":4,"TC":4,"EXH":4,"MGU-K":3,"ES":3,"PU-CE":3,"PU-ANC":5},"team":"Haas"},{"n":"87","car":"Haas Ferrari","driver":"Oliver Bearman","used":{"ICE":4,"TC":4,"EXH":4,"MGU-K":4,"ES":4,"PU-CE":4,"PU-ANC":4},"team":"Haas"},{"n":"27","car":"Audi","driver":"Nico Hülkenberg","used":{"ICE":4,"TC":4,"EXH":4,"MGU-K":3,"ES":2,"PU-CE":2,"PU-ANC":5},"team":"Audi"},{"n":"5","car":"Audi","driver":"Gabriel Bortoleto","used":{"ICE":3,"TC":3,"EXH":3,"MGU-K":3,"ES":3,"PU-CE":3,"PU-ANC":5},"team":"Audi"},{"n":"10","car":"Alpine Mercedes","driver":"Pierre Gasly","used":{"ICE":4,"TC":3,"EXH":3,"MGU-K":2,"ES":3,"PU-CE":3,"PU-ANC":5},"team":"Alpine"},{"n":"43","car":"Alpine Mercedes","driver":"Franco Colapinto","used":{"ICE":4,"TC":3,"EXH":2,"MGU-K":2,"ES":3,"PU-CE":3,"PU-ANC":4},"team":"Alpine"},{"n":"11","car":"Cadillac Ferrari","driver":"Sergio Perez","used":{"ICE":4,"TC":4,"EXH":3,"MGU-K":3,"ES":3,"PU-CE":3,"PU-ANC":4},"team":"Cadillac"},{"n":"77","car":"Cadillac Ferrari","driver":"Valtteri Bottas","used":{"ICE":3,"TC":3,"EXH":3,"MGU-K":3,"ES":3,"PU-CE":3,"PU-ANC":3},"team":"Cadillac"}],"upgrades":[{"team":"McLaren","updates":[{"component":"Coke/Engine Cover","reason":"Circuit specific - Cooling Range","type":"Circuit specific","geometry":"High Cooling Bodywork","description":"To meet the high cooling demands of this and the upcoming circuits, a new engine cover aiming at increased cooling massflow has been designed.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Mercedes","updates":[{"component":"Floor Board","reason":"Performance – Local Load","type":"Performance","geometry":"Reprofiled horizontal elements, and vertical slotted upper element added.","description":"Reprofiled elements and new vertical elements added to improve local pressure distribution, reduce separations at the extremes of the operating envelope, and improve flow to the rear of the car, resulting in increased load.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Floor Leading Edge","reason":"Performance - Flow Conditioning","type":"Performance","geometry":"Reprofiled and additional down-washing elements added.","description":"Additional down-washing elements increase local load and outwash, improving flow to the rear of the car and increasing rear floor load.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Floor Corner","reason":"Performance - Flow Conditioning","type":"Performance","geometry":"Additional slots and reprofiled elements.","description":"Re-optimisation of floor corner slot arrangement to both increase local load and to also improve flow into the diffuser and hence rear load.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Floor Body","reason":"Performance – Local Load","type":"Performance","geometry":"Reprofiled diffuser roof, sidewall, and winglet.","description":"Through re-optimisation of the diffuser roof and sidewall we have increased local load and improved robustness throughout the operating envelope.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Rear Suspension","reason":"Performance – Local Load","type":"Performance","geometry":"Reprofiled suspension fairings.","description":"Track rod and driveshaft camber re-distributed to increase local load whilst improving coupling with diffuser winglet and rear drum furniture.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Rear Corner","reason":"Performance – Local Load","type":"Performance","geometry":"Rear winglet span and position change.","description":"Chord and position of the rear drum winglets re- optimised to work with above fairing update and to improve rear tyre wake control across the operating envelope.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Rear Bodywork","reason":"Performance - Flow Conditioning","type":"Performance","geometry":"Reduce volume, increased sideview ramp.","description":"Reduce volume and increased sideview ramp increases downwash to the rear floor and rear drum, resulting in more load.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Red Bull Racing","updates":[{"component":"Floor Board","reason":"Performance - Local Load","type":"Performance","geometry":"Revised Floor Board geometry","description":"Applied above the existing floor foot geometry, the new board realises development work to extract more load locally whilst maintaining flow stability behind the front tyres.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Ferrari","updates":[{"component":"Diffuser","reason":"Performance - Local Load development","type":"Performance","geometry":"Diffuser outboard winglet cascade element","description":"Not Sepang track specific, this very localized development around the diffuser winglet cascade is providing a favourable additional downforce across the entire car operating envelope","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Williams","updates":[]},{"team":"Racing Bulls","updates":[{"component":"Front Wing","reason":"Circuit specific - Balance Range","type":"Circuit specific","geometry":"New front flap","description":"A longer chord flap for the front wing that was introduced at the previous event increases the load that can be generated by the wing, meeting the aero balance requirements for this circuit.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"},{"component":"Rear Wing","reason":"Performance - Local Load","type":"Performance","geometry":"Revised rear wing auxiliary components","description":"An improved design of the rear wing support components allows the rear wing to perform more effectively, increasing the efficiency of load generated.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Aston Martin","updates":[]},{"team":"Haas","updates":[{"component":"Rear Impact Structure","reason":"Performance – Local Load","type":"Performance","geometry":"Updated Rear Impact Structure geometry","description":"An additional Rear Impact Structure device will be available on track, enabling targeted tuning of the car’s characteristics for this circuit.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Audi","updates":[]},{"team":"Alpine","updates":[{"component":"Front Corner","reason":"Performance – Brake Cooling","type":"Performance","geometry":"Revised front drum exit","description":"The front drum exit has been trimmed to increase brake cooling capacity, improving thermal management for the upcoming high-demand tracks.","source":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"}]},{"team":"Cadillac","updates":[]}],"sources":{"pu":"https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_pu_elements_used_per_driver_up_to_now.pdf","upgrades":["https://www.fia.com/system/files/decision-document/2026_bahrain_grand_prix_in_malaysia_-_car_presentation_submissions.pdf"]},"upgradesChecked":true}